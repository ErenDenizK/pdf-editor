{
  "name": "pdf-editor-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A free, open-source PDF editor that runs entirely in the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @pdf-editor/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "preview": "pnpm --filter @pdf-editor/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @pdf-editor/web test:e2e",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}

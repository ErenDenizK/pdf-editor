{
  "name": "pdf-editor-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "A free, open-source PDF editor that runs entirely in the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @pdf-editor/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "preview": "pnpm --filter @pdf-editor/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @pdf-editor/web i18n && eslint . --max-warnings=0",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @pdf-editor/web test:e2e",
    "changeset": "changeset",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.63.0",
    "@types/node": "^22.20.4",
    "@vitest/browser-playwright": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "tesseract.js@7.0.0": "patches/tesseract.js@7.0.0.patch"
    }
  }
}

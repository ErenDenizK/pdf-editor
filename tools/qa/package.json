{
  "name": "@pdf-editor/qa-tool",
  "version": "0.0.0",
  "private": true,
  "description": "Manual cross-viewer QA helpers: builds docs/qa/samples/annotations-sample.pdf with the app's own PDFium adapter.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "sample": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@embedpdf/pdfium": "2.15.1",
    "@pdf-editor/document-model": "workspace:*",
    "@pdf-editor/engine": "workspace:*"
  }
}

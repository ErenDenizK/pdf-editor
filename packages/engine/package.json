{
  "name": "@pdf-editor/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Engine interfaces (PdfRenderer, PdfEditor, PdfAssembler, PdfPlumber) and their adapters. UI code depends only on the interfaces.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./assembler.worker": {
      "types": "./src/worker/assembler.worker.ts",
      "import": "./src/worker/assembler.worker.ts"
    },
    "./analysis.worker": {
      "types": "./src/worker/analysis.worker.ts",
      "import": "./src/worker/analysis.worker.ts"
    },
    "./compress.worker": {
      "types": "./src/worker/compress.worker.ts",
      "import": "./src/worker/compress.worker.ts"
    },
    "./pdfium.worker": {
      "types": "./src/worker/pdfium.worker.ts",
      "import": "./src/worker/pdfium.worker.ts"
    },
    "./qpdf.wasm": "./qpdf/dist/qpdf.wasm",
    "./overlay-geometry": {
      "types": "./src/pdflib/overlay-public.ts",
      "import": "./src/pdflib/overlay-public.ts"
    },
    "./fonts": {
      "types": "./src/fonts/index.ts",
      "import": "./src/fonts/index.ts"
    },
    "./signature.worker": {
      "types": "./src/worker/signature.worker.ts",
      "import": "./src/worker/signature.worker.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "echo 'source package; built by the consuming app'"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@pdf-editor/document-model": "workspace:*",
    "asn1js": "3.0.10",
    "comlink": "^4.4.2",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "pixelmatch": "7.2.0",
    "pkijs": "3.4.1"
  }
}
